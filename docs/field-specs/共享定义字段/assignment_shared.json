{
  "实体": "大作业共享定义",
  "来源物理表": "assignment",
  "说明": "每条大作业记录维护一份共享定义，同一对象的适用学员复用；不是全系统只有一条记录，也不是新增物理表。教师或管理员仍可修改配置；不同课程、作业或期次版本可不同。",
  "字段": [
    {
      "字段名": "assignment_id",
      "类型": "string",
      "说明": "大作业定义的随机唯一 ID，主键。",
      "必填": true
    },
    {
      "字段名": "course_id",
      "类型": "string",
      "说明": "归属课程的唯一 ID；一门课可对应多个大作业。",
      "必填": true
    },
    {
      "字段名": "name",
      "类型": "string",
      "说明": "大作业名称。",
      "必填": true
    },
    {
      "字段名": "description",
      "类型": "string | null",
      "说明": "作业说明。",
      "必填": false
    },
    {
      "字段名": "requirement_pdf",
      "类型": "FileRef",
      "说明": "教师提供的作业要求 PDF，与学生提交材料区分。",
      "必填": true
    },
    {
      "字段名": "grading_criteria",
      "类型": "GradingCriterion[]",
      "说明": "教师设置的评分维度和分值。",
      "必填": true
    },
    {
      "字段名": "submission_rules",
      "类型": "SubmissionRules",
      "说明": "材料是否必交的配置；具体必填项需确认。",
      "必填": true
    },
    {
      "字段名": "status",
      "类型": "string",
      "说明": "作业定义状态，具体枚举待确定；不同于学生提交状态。",
      "必填": true
    },
    {
      "字段名": "created_by",
      "类型": "string",
      "说明": "创建人的 account ID。",
      "必填": true
    },
    {
      "字段名": "created_at",
      "类型": "datetime",
      "说明": "创建时间，带时区。",
      "必填": true
    },
    {
      "字段名": "steps",
      "类型": "string[]",
      "说明": "四个展示步骤：提交材料、助教审核、确定汇报时间、汇报通过；具体步骤状态由学生提交实例的状态派生。",
      "必填": true
    }
  ],
  "嵌套类型": {
    "FileRef": [
      {
        "字段名": "original_name",
        "类型": "string",
        "说明": "上传时的原始文件名。",
        "必填": true
      },
      {
        "字段名": "oss_key",
        "类型": "string",
        "说明": "对象存储中的对象标识，不依赖永久公开链接。",
        "必填": true
      }
    ],
    "GradingCriterion": [
      {
        "字段名": "criterion_id",
        "类型": "string",
        "说明": "评分维度 ID。",
        "必填": true
      },
      {
        "字段名": "name",
        "类型": "string",
        "说明": "评分维度名称。",
        "必填": true
      },
      {
        "字段名": "max_score",
        "类型": "number",
        "说明": "该维度满分。",
        "必填": true
      },
      {
        "字段名": "items",
        "类型": "string[]",
        "说明": "细则条目；没有时为空数组。",
        "必填": true
      }
    ],
    "SubmissionRules": [
      {
        "字段名": "ppt_required",
        "类型": "boolean",
        "说明": "是否必须提交汇报 PPT；取值由教师配置。",
        "必填": true
      },
      {
        "字段名": "repository_required",
        "类型": "boolean",
        "说明": "是否必须填写代码仓库地址；取值由教师配置。",
        "必填": true
      },
      {
        "字段名": "video_required",
        "类型": "boolean",
        "说明": "是否必须提供演示视频；取值由教师配置。",
        "必填": true
      },
      {
        "字段名": "student_pdf_required",
        "类型": "boolean | null",
        "说明": "是否必须提交学生 PDF；null 表示需求待确认。",
        "必填": false
      }
    ]
  }
}
