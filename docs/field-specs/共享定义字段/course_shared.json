{
  "实体": "课程共享定义",
  "来源物理表": "course",
  "说明": "每条课程记录维护一份共享定义，同一对象的适用学员复用；不是全系统只有一条记录，也不是新增物理表。教师或管理员仍可修改配置；不同课程、作业或期次版本可不同。",
  "字段": [
    {
      "字段名": "course_id",
      "类型": "string",
      "说明": "课程随机唯一 ID，主键；不同期次复用展示编号时也能区分。",
      "必填": true
    },
    {
      "字段名": "name",
      "类型": "string",
      "说明": "课程名称。",
      "必填": true
    },
    {
      "字段名": "level",
      "类型": "string",
      "说明": "所属阶，如初阶；具体枚举待确定。",
      "必填": true
    },
    {
      "字段名": "cohort_ids",
      "类型": "string[]",
      "说明": "适用的培养期次 ID 列表；期次指学生所属培养期次，不是年级。",
      "必填": true
    },
    {
      "字段名": "description",
      "类型": "string | null",
      "说明": "课程简介。",
      "必填": false
    },
    {
      "字段名": "materials",
      "类型": "CourseMaterial[]",
      "说明": "课程资料；没有资料时为空数组。",
      "必填": true
    },
    {
      "字段名": "chapters",
      "类型": "Chapter[]",
      "说明": "按展示顺序排列的章节及其任务。",
      "必填": true
    },
    {
      "字段名": "status",
      "类型": "string",
      "说明": "课程状态；草稿、发布等具体枚举待确定。",
      "必填": true
    },
    {
      "字段名": "created_by",
      "类型": "string",
      "说明": "创建人的 account ID。",
      "必填": true
    },
    {
      "字段名": "created_at",
      "类型": "datetime",
      "说明": "创建时间，带时区。",
      "必填": true
    },
    {
      "字段名": "updated_at",
      "类型": "datetime",
      "说明": "最后更新时间，带时区。",
      "必填": true
    },
    {
      "字段名": "teacher_id",
      "类型": "string | null",
      "说明": "授课教师的账号 ID，未指定时为空。",
      "必填": false
    }
  ],
  "嵌套类型": {
    "CourseMaterial": [
      {
        "字段名": "name",
        "类型": "string",
        "说明": "资料显示名称。",
        "必填": true
      },
      {
        "字段名": "oss_key",
        "类型": "string | null",
        "说明": "OSS 文件对象标识；与外部资源 URL 至少填写一项。",
        "必填": false
      },
      {
        "字段名": "url",
        "类型": "string | null",
        "说明": "外部课程资料链接；与 oss_key 至少填写一项。",
        "必填": false
      },
      {
        "字段名": "password",
        "类型": "string | null",
        "说明": "课程资料访问密码；如为敏感信息应控制查看权限，不写入日志。",
        "必填": false
      }
    ],
    "Chapter": [
      {
        "字段名": "chapter_id",
        "类型": "string",
        "说明": "章节稳定 ID；不可因排序变化而更换。",
        "必填": true
      },
      {
        "字段名": "name",
        "类型": "string",
        "说明": "章节名称。",
        "必填": true
      },
      {
        "字段名": "tasks",
        "类型": "Task[]",
        "说明": "按顺序排列的任务。",
        "必填": true
      },
      {
        "字段名": "no",
        "类型": "string",
        "说明": "展示用顺序编号，如 01；稳定身份仍以 chapter_id 为准。",
        "必填": true
      }
    ],
    "Task": [
      {
        "字段名": "task_id",
        "类型": "string",
        "说明": "任务稳定 ID；不可因排序变化而更换。",
        "必填": true
      },
      {
        "字段名": "name",
        "类型": "string",
        "说明": "任务名称。",
        "必填": true
      },
      {
        "字段名": "description",
        "类型": "string | null",
        "说明": "任务说明。",
        "必填": false
      },
      {
        "字段名": "estimated_minutes",
        "类型": "integer",
        "说明": "预计完成分钟数，取 30 的正整数倍。",
        "必填": true
      },
      {
        "字段名": "counts_toward_progress",
        "类型": "boolean",
        "说明": "是否计入课程学习进度。",
        "必填": true
      },
      {
        "字段名": "no",
        "类型": "string",
        "说明": "展示用顺序编号，如 01；稳定身份仍以 task_id 为准。",
        "必填": true
      }
    ]
  },
  "共享内容派生字段": [
    {
      "字段名": "chapter_count",
      "类型": "integer",
      "说明": "章节数，由 chapters 计算。",
      "必填": true
    },
    {
      "字段名": "chapter_titles",
      "类型": "string[]",
      "说明": "按章节顺序获取章节名称。",
      "必填": true
    },
    {
      "字段名": "display_number",
      "类型": "string",
      "说明": "仅章节和任务保留 01、02 等展示序号；课程不再设置展示序号。",
      "必填": true
    }
  ],
  "规则": [
    "课程不设置 01、02、03 等展示序号；课程随机唯一 ID 保留。章节和任务编号不受此调整影响。"
  ]
}
