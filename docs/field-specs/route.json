{
  "实体": "学习路线",
  "物理表": "route",
  "说明": "一条记录代表一条路线；课程按 course_ids 数组顺序学习。字段类型是后端逻辑类型，实际数据库类型由选型确定。",
  "字段": [
    {
      "字段名": "route_id",
      "类型": "string",
      "说明": "路线随机唯一 ID，主键。",
      "必填": true
    },
    {
      "字段名": "name",
      "类型": "string",
      "说明": "路线名称。",
      "必填": true
    },
    {
      "字段名": "level",
      "类型": "string",
      "说明": "所属阶，如初阶；具体枚举待确定。",
      "必填": true
    },
    {
      "字段名": "description",
      "类型": "string | null",
      "说明": "路线简介。",
      "必填": false
    },
    {
      "字段名": "course_ids",
      "类型": "string[]",
      "说明": "按学习顺序排列的课程唯一 ID；课程名称从课程实体获取。",
      "必填": true
    },
    {
      "字段名": "status",
      "类型": "string",
      "说明": "路线状态；草稿、发布等具体枚举待确定。",
      "必填": true
    },
    {
      "字段名": "created_by",
      "类型": "string",
      "说明": "创建人的 account ID。",
      "必填": true
    },
    {
      "字段名": "created_at",
      "类型": "datetime",
      "说明": "创建时间，使用带时区的 ISO 8601 时间。",
      "必填": true
    },
    {
      "字段名": "updated_at",
      "类型": "datetime",
      "说明": "最后更新时间，使用带时区的 ISO 8601 时间。",
      "必填": true
    },
    {
      "字段名": "period",
      "类型": "string",
      "说明": "路线适用培养期次 ID；不同期次的路线可分别建记录。",
      "必填": true
    }
  ],
  "派生字段": [
    {
      "字段名": "course_count",
      "类型": "integer",
      "说明": "课程数量，由 course_ids 计算，不重复保存。",
      "必填": true
    },
    {
      "字段名": "course_titles",
      "类型": "string[]",
      "说明": "按 course_ids 顺序查询课程名称，不重复保存。",
      "必填": true
    }
  ],
  "规则": [
    "必须通过上一门课程后才能开始路线中的下一门课程。",
    "路线与课程的关联存于 courseids；删除或更改课程前需检查引用。",
    "学生使用的路线 ID 由 account 学习信息保存；本模块不新建表。",
    "同一学生同一时间使用一条路线，account 中的路线标识字段由 account 模块约定。",
    "同一期次的路线记录须与课程适用期次相匹配。"
  ]
}
