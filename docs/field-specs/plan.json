{
  "实体": "规划",
  "物理表": "plan",
  "说明": "一条规划只属于一个人；规划与待办互不关联，只认人、不认任务。",
  "字段": [
    {
      "字段名": "id",
      "类型": "string",
      "必填": true,
      "唯一": true,
      "格式": "plan_ + 随机串",
      "说明": "规划唯一 ID，供账号侧的规划数组引用。"
    },
    {
      "字段名": "account_id",
      "类型": "string",
      "必填": true,
      "引用": "account.account_id",
      "说明": "所属人 ID，指向 account.account_id。"
    },
    {
      "字段名": "level",
      "类型": "string",
      "必填": true,
      "enum": ["year", "month", "week", "today"],
      "enum_labels": {
        "year": "本年",
        "month": "本月",
        "week": "本周",
        "today": "今天"
      },
      "说明": "时间层级，决定归到哪张卡片；前端按此分组展示。"
    },
    {
      "字段名": "content",
      "类型": "string",
      "必填": true,
      "说明": "规划内容，一句话目标。"
    },
    {
      "字段名": "date",
      "类型": "string",
      "必填": true,
      "格式": "YYYY-MM-DD",
      "说明": "目标日期，只记日期不做范围，前端不使用日历控件。"
    }
  ],
  "规则": [
    "level 只能是 year、month、week、today 四个机器值，未定义的自由文本不得写入。",
    "date 为纯日期字符串，不含时间与时区；需要精确时刻的场景不适用本表。"
  ]
}
